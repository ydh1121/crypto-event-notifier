# ===== Core market data =====
BTC_MARKET=KRW-BTC
ETH_MARKET=KRW-ETH
WEBSOCKET_ENABLED=true
PRIVATE_WEBSOCKET_ENABLED=false
OKX_DERIVATIVES_ENABLED=true
CANDLE_UNIT_MINUTES=5
CANDLE_COUNT=48

# ===== Local paper account =====
PAPER_START_KRW=1000000
B3_JOURNAL_DB=b3_trader/data/crypto_trader.sqlite3
ASSET_REGISTRY_PATH=control/assets.json
RUNTIME_CONFIG_PATH=control/runtime.json

# ===== Dashboard =====
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8765
DASHBOARD_DIR=dashboard
# Leave empty: first run generates b3_trader/data/dashboard-token.txt
DASHBOARD_TOKEN=

# ===== Cloudflare Pages read-only viewer (optional) =====
# scripts/setup-cloudflare-pages-viewer.ps1 fills these after one browser OAuth.
CLOUDFLARE_VIEWER_PROJECT=crypto-paper-viewer-ydh1121
CLOUDFLARE_VIEWER_D1=crypto-paper-viewer
CLOUDFLARE_VIEWER_INGEST_URL=
CLOUDFLARE_VIEWER_INGEST_TOKEN=
# false keeps manual holdings/average price only on the PC.
# The one-time setup enables this for the authenticated owner; set false again to stop publishing them.
CLOUDFLARE_PUBLISH_PRIVATE_HOLDINGS=false

# ===== Telegram =====
TELEGRAM_ENABLED=false
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ===== GPT/GitHub control-plane sync =====
AUTO_GIT_SYNC=true
AUTO_GIT_PUSH_CONTROL=true
GIT_SYNC_BRANCH=b3-auto-trader-phase1
GIT_SYNC_INTERVAL_SECONDS=15
GIT_REPO_DIR=.

# ===== Local + Google Drive backup =====
BACKUP_INTERVAL_SECONDS=3600
LOCAL_BACKUP_DIR=b3_trader/data/backups
# One-time local rclone setup is required. Empty disables Drive upload.
RCLONE_REMOTE=gdrive:Crypto Auto Trader/backups

# ===== Phase 5 macro intelligence providers (optional) =====
# BEA registered API access is optional; the official BEA news-release fallback
# remains available when this is empty.
BEA_API_KEY=
# Survey-consensus snapshots require a Trading Economics API subscription key.
# Store the real key only in the local .env file; never commit it.
TRADING_ECONOMICS_API_KEY=

# ===== Bithumb private API (NOT REQUIRED FOR PAPER MODE) =====
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=
LIVE_TRADING_ENABLED=false
LIVE_TRADING_ACK=
