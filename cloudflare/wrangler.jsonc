{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "b3-trader",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "B3TraderContainer",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "B3_TRADER",
        "class_name": "B3TraderContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["B3TraderContainer"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
